{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "eastus"
    },
    "environmentName": {
      "value": "afsThrottleLab"
    },
    "vmSize": {
      "value": "Standard_B2s"
    },
    "vmAdminUsername": {
      "value": "afsadmin"
    },
    "dataDiskSizeGiB": {
      "value": 32
    },
    "shareQuotaGiB": {
      "value": 100
    },
    "syncServicePrivateDnsZoneName": {
      "value": "privatelink.afs.azure.net"
    },
    "allowStorageSharedKeyAccess": {
      "value": true
    },
    "storagePublicNetworkAccess": {
      "value": "Enabled"
    }
  }
}